{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Regent: Build Module",
      "type": "shell",
      "command": "regent",
      "args": ["build"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Regent: Run Tests",
      "type": "shell",
      "command": "regent",
      "args": ["test"],
      "problemMatcher": "$regent-test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Regent: Lint Module",
      "type": "shell",
      "command": "regent",
      "args": ["lint"],
      "problemMatcher": "$regent-lint",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Regent: Lint (JSON output)",
      "type": "shell",
      "command": "regent",
      "args": ["lint", "--report", "json"],
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
