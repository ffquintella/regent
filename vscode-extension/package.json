{
  "name": "regent",
  "displayName": "Regent - OpenVox Development Kit",
  "description": "Lightweight Puppet development toolkit powered by Rust. Build, test, and validate Puppet modules with speed.",
  "version": "0.9.2",
  "publisher": "regent",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "puppet",
    "regent",
    "devops",
    "infrastructure",
    "automation"
  ],
  "activationEvents": [
    "onLanguage:puppet",
    "workspaceContains:**/metadata.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "puppet",
        "aliases": [
          "Puppet",
          "puppet"
        ],
        "extensions": [
          ".pp"
        ],
        "configuration": "./languages/puppet.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "puppet",
        "scopeName": "source.puppet",
        "path": "./syntaxes/puppet.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "regent.build",
        "title": "Regent: Build Module",
        "icon": "$(package)"
      },
      {
        "command": "regent.test",
        "title": "Regent: Run Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "regent.lint",
        "title": "Regent: Lint Module",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "regent.validators",
        "title": "Regent: List Validators"
      },
      {
        "command": "regent.generate",
        "title": "Regent: Generate Component"
      },
      {
        "command": "regent.fixAll",
        "title": "Regent: Fix All Auto-fixable Issues",
        "icon": "$(wrench)"
      },
      {
        "command": "regent.setupWorkspace",
        "title": "Regent: Setup Workspace",
        "icon": "$(tools)"
      }
    ],
    "configuration": {
      "title": "Regent",
      "properties": {
        "regent.binaryPath": {
          "type": "string",
          "default": "regent",
          "description": "Path to the Regent binary. Leave as 'regent' to use PATH.",
          "scope": "machine-overridable"
        },
        "regent.puppetVersion": {
          "type": "string",
          "default": "",
          "description": "Puppet version hint for validation (e.g., '7.x', '8.x'). Leave empty for auto-detection.",
          "scope": "resource"
        },
        "regent.rubyVersion": {
          "type": "string",
          "default": "",
          "description": "Ruby version hint for validation (e.g., '3.1', '3.2'). Leave empty for auto-detection.",
          "scope": "resource"
        },
        "regent.lintOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run regent lint automatically when saving Puppet files.",
          "scope": "resource"
        },
        "regent.failOnWarnings": {
          "type": "boolean",
          "default": false,
          "description": "Treat lint warnings as errors.",
          "scope": "resource"
        },
        "regent.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show lint issues in the Problems panel.",
          "scope": "resource"
        }
      }
    },
    "problemMatchers": [
      {
        "name": "regent-lint",
        "owner": "regent",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(error|warning|info):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      {
        "name": "regent-test",
        "owner": "regent",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s+Failure/Error:\\s+(.+)$",
          "message": 1
        }
      }
    ],
    "snippets": [
      {
        "language": "puppet",
        "path": "./snippets/puppet.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "regent",
        "required": ["command"],
        "properties": {
          "command": {
            "type": "string",
            "description": "The Regent command to run (build, test, lint)"
          },
          "args": {
            "type": "array",
            "description": "Additional arguments"
          }
        }
      }
    ]
  },
  "scripts": {
    "sync-version": "python3 ../scripts/sync-vscode-version.py",
    "vscode:prepublish": "npm run sync-version && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "npm run compile && node ./out/test/runTest.js",
    "test:minimum": "npm run compile && node ./out/test/runTest.js --minimum",
    "package": "npm run sync-version && vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.12.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3",
    "@vscode/vsce": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/regent/regent-vscode"
  },
  "license": "MIT"
}
